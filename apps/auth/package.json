{
  "name": "auth",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm build && concurrently -k \"swc src -d dist --strip-leading-paths --watch\" \"node --watch dist/main.js\"",
    "build": "swc src -d dist --strip-leading-paths",
    "check-types": "tsc --noEmit -p tsconfig.build.json",
    "start": "node dist/main",
    "start:debug": "node --inspect --watch dist/main.js",
    "start:prod": "node dist/main",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:e2e": "vitest run --config vitest.config.e2e.mts",
    "test:cov": "vitest run --config vitest.config.mts --coverage",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "escape-html": "1.0.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@nestjs/testing": "12.1.3",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.18",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "source-map-support": "0.5.21",
    "supertest": "7.3.1",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "7.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
